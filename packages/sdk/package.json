{
  "name": "@1api/sdk",
  "version": "0.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "description": "one-api HTTP CRUD 客户端（基于 fetch，isomorphic，对接 /api/data/*）",
  "license": "MIT",
  "author": "Yourtion <yourtion@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourtion/one-api.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/yourtion/one-api#readme",
  "bugs": {
    "url": "https://github.com/yourtion/one-api/issues"
  },
  "keywords": [
    "one-api",
    "ai-native",
    "database",
    "sdk",
    "http-client",
    "fetch"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@1api/shared": "workspace:*"
  },
  "devDependencies": {
    "@1api/server": "workspace:*",
    "@vitest/coverage-v8": "^3",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
