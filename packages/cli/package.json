{
  "name": "one-api-cli",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "one-api-cli": "./dist/index.js"
  },
  "files": ["dist", "CHANGELOG.md", "LICENSE"],
  "description": "one-api 终端工具（远程模式走 SDK + 本地直连模式走 engine）",
  "license": "MIT",
  "author": "Yourtion <yourtion@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourtion/one-api.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/yourtion/one-api#readme",
  "bugs": {
    "url": "https://github.com/yourtion/one-api/issues"
  },
  "keywords": [
    "one-api",
    "ai-native",
    "database",
    "cli",
    "terminal",
    "command-line"
  ],
  "preferGlobal": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@1api/shared": "workspace:*",
    "@1api/sdk": "workspace:*",
    "@1api/engine": "workspace:*",
    "@inquirer/prompts": "^8.5.2",
    "better-sqlite3": "^12.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@1api/server": "workspace:*",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3",
    "kysely": "^0.29.0",
    "tsx": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
