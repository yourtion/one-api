{
  "name": "one-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "start": "node apps/server/dist/index.js",
    "release": "pnpm quality && pnpm release:preflight && node -e \"console.log('Local checks passed. Publishing requires the reviewed tag workflow; see docs/npm-publishing.md.')\"",
    "docs:dev": "pnpm --filter @1api/docs docs:dev",
    "docs:build": "pnpm --filter @1api/docs docs:build",
    "docs:gen-api": "pnpm --filter @1api/docs gen:api-docs",
    "coverage": "pnpm --filter @1api/shared --filter @1api/engine --filter @1api/sdk --filter @1api/cli --filter @1api/server --filter @1api/serve exec vitest run --coverage",
    "quality": "pnpm -r build && pnpm -r typecheck && pnpm -r test && pnpm test:release && pnpm coverage && pnpm lint",
    "release:preflight": "node scripts/release-preflight.mjs",
    "test:release": "node --test scripts/release-preflight.test.mjs scripts/npm-release.test.mjs"
  },
  "devDependencies": {
    "oxlint": "^0.9.0",
    "typescript": "^5.8.0",
    "oxfmt": "0.74.0"
  }
}
