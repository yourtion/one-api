{
  "name": "@1api/server",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "DEBUG=one-api:request,one-api:sql tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@1api/engine": "workspace:*",
    "@1api/shared": "workspace:*",
    "@erest/leizmweb": "^3.2.1",
    "@leizm/web": "^2.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bcrypt": "^5.1.0",
    "better-sqlite3": "^12.0.0",
    "debug": "^4.3.0",
    "erest": "^3.2.1",
    "kysely": "^0.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/debug": "^4.1.0",
    "@vitest/coverage-v8": "^3",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
